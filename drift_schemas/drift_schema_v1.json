  "fixed_sql": [
    {
      "name": "children",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"children\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"rule_id\" TEXT NOT NULL, \"school_year_start\" TEXT NOT NULL, \"school_year_end\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "subjects",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"subjects\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL COLLATE NOCASE UNIQUE, \"is_core\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_core\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL DEFAULT 0);"
        }
      ]
    },
    {
      "name": "log_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"log_entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"child_id\" INTEGER NOT NULL REFERENCES children (id), \"subject_id\" INTEGER NOT NULL REFERENCES subjects (id), \"day\" TEXT NOT NULL, \"minutes\" INTEGER NOT NULL, \"note\" TEXT NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "work_samples",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"work_samples\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"child_id\" INTEGER NOT NULL REFERENCES children (id), \"subject_id\" INTEGER NULL REFERENCES subjects (id), \"day\" TEXT NOT NULL, \"title\" TEXT NULL, \"file_path\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "custom_rules",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"custom_rules\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"label\" TEXT NOT NULL, \"required_hours\" INTEGER NULL, \"required_days\" INTEGER NULL, CHECK (required_hours IS NOT NULL OR required_days IS NOT NULL));"
        }
      ]
    },
    {
      "name": "entitlement",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"entitlement\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"paid_until\" TEXT NULL, \"last_verified_at\" TEXT NULL, \"plan\" TEXT NOT NULL DEFAULT 'free');"
        }
      ]
    }
